# MongoDB (local dev default shown; use Atlas for deployment)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dreamduel

# Somnia Shannon testnet — optional override for the EC public client.
# Defaults are baked in: the app tiers across three testnet RPC mirrors
# (thirdweb mirror first, then dream-rpc, then api.infra) so a rate-limited
# or down primary never blocks wallet approves, stakes, or balance reads.
SOMNIA_RPC_URL=

# The escrow admin / ghost relay operator. Warmed with STT gas on testnet.
# https://testnet.somnia.network
OPERATOR_PRIVATE_KEY=0x...

# WalletConnect Cloud project ID (required for mobile / WalletConnect pairing).
# Optional for desktop browser-extension wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Protect the developer wipe endpoint (/api/matchmaking/clear).
# When set, requests must send this value in the X-Admin-Token header.
ADMIN_TOKEN=