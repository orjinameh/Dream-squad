# MongoDB connection (local dev default shown)
MONGODB_URI=
MONGODB_DB=

# Somnia Shannon testnet
SOMNIA_RPC_URL=https://dream-rpc.somnia.network

# Phase 3 — executor operator wallet
# Must be warmed (funded with >=0.05 STT) before the worker starts.
OPERATOR_PRIVATE_KEY=0x...

# Phase 5 — E2E testnet script funding account
# Grants the operator order-delegation on Somnia testnet (scripts/e2e-testnet.ts).
FUND_KEY=0x...

# Optional: protect the developer wipe endpoint (/api/matchmaking/clear).
# When set, requests must send this value in the X-Admin-Token header.
ADMIN_TOKEN=
